# =============================================================================
#  GLM 4.6 Document Extraction Benchmark - environment template
#  Copy to `.env` and fill in the values.  NEVER commit a real `.env`.
# =============================================================================

# --- GLM 4.6 / Z.AI credentials ---------------------------------------------
# Where to get a key:
#   * International (Z.AI)   : https://z.ai  -> API Keys  -> env ZAI_API_KEY
#   * Mainland China (BigModel): https://open.bigmodel.cn -> env ZHIPUAI_API_KEY
# Put the key of YOUR platform here. `ZHIPUAI_API_KEY` is also honoured.
GLM_API_KEY=

# OpenAI-compatible endpoint of the platform that issued the key.
#   Z.AI      : https://api.z.ai/api/paas/v4/
#   BigModel  : https://open.bigmodel.cn/api/paas/v4/
GLM_BASE_URL=https://api.z.ai/api/paas/v4/

# Vision (multimodal) model used for page recognition.
# IMPORTANT: plain `glm-4.6` is TEXT-ONLY. To feed page images you must use a
# multimodal member of the GLM family, e.g. `glm-4.6v`, `glm-4.6v-flash`
# or `glm-4.5v`.  The client walks the list below left-to-right and uses the
# first model the endpoint accepts.
GLM_MODEL=glm-4.6v
GLM_MODEL_FALLBACKS=glm-4.6v-flash,glm-4.5v

# Sampling / limits. Low temperature keeps OCR-like output deterministic.
GLM_TEMPERATURE=0.1
GLM_MAX_TOKENS=8192
GLM_TIMEOUT_SECONDS=180
GLM_MAX_RETRIES=2
# Ask the endpoint for strict JSON output where supported.
GLM_JSON_MODE=true

# Offline mode: no API key needed, returns a stub document per page.
# Useful for UI smoke tests. MUST be false for real benchmarks.
GLM_MOCK=false

# --- Upload / rendering ------------------------------------------------------
MAX_UPLOAD_MB=50
ALLOWED_EXTENSIONS=.pdf,.docx
RENDER_DPI=200
RENDER_MAX_PAGES=50
# pymupdf (bundled, recommended) | pdf2image (needs poppler on PATH)
RENDERER_BACKEND=pymupdf
# A PDF page with fewer than this many characters is treated as having NO
# text layer (this is what file B is validated against).
TEXT_LAYER_MIN_CHARS=20

# --- Data / CORS -------------------------------------------------------------
# Uploaded files, rendered pages, crops and JSON results live here.
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEBUG=false
